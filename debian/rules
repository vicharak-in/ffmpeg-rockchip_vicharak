#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable).
# Output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# See FEATURE AREAS in dpkg-buildflags(1).
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# See ENVIRONMENT in dpkg-buildflags(1).
# Package maintainers to append CFLAGS.
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# Package maintainers to append LDFLAGS.
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed


%:
	dh $@


# dh_make generated override targets.
# This is an example for Cmake (see <https://bugs.debian.org/641051>).
override_dh_auto_clean:
	dh_auto_clean

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_build:
	make

override_dh_auto_test:
	# do nothing, skip tests

override_dh_auto_install:
	dh_auto_install
	install -d debian/tmp/usr/lib/vicharak
	install -m 755 /usr/lib/aarch64-linux-gnu/librockchip_mpp.so.1 debian/tmp/usr/lib/vicharak/
	ln -sf librockchip_mpp.so.1 debian/tmp/usr/lib/vicharak/librockchip_mpp.so
	install -m 755 /usr/lib/librga.so debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/librga.so.2 debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/librga.so.2.1.0 debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/libvmaf.so debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/libvmaf.so.3 debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/libvmaf.so.3.0.0 debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/aarch64-linux-gnu/libaom.so.3.3.0 debian/tmp/usr/lib/vicharak/
	install -m 755 /usr/lib/aarch64-linux-gnu/libaom.so.3 debian/tmp/usr/lib/vicharak/
	ln -sf libaom.so.3 debian/tmp/usr/lib/vicharak/libaom.so
	install -m 755 /usr/lib/libx265.so.* debian/tmp/usr/lib/vicharak/
	ln -sf libx265.so.215 debian/tmp/usr/lib/vicharak/libx265.so
	dh_install

override_dh_auto_configure:
	./configure \
	--prefix=/usr \
	--extra-ldflags="-Wl,-rpath=/usr/lib/vicharak/" \
	--enable-gpl \
	--enable-version3 \
	--enable-libdrm \
	--enable-rkmpp \
	--enable-rkrga \
	--enable-libx264 \
	--enable-libx265 \
	--enable-libvpx \
	--enable-libfdk-aac \
	--enable-nonfree \
	--enable-libopus \
	--enable-libaom \
	--enable-libsvtav1 \
	--enable-libdav1d \
	--enable-libvmaf \
	--enable-libass \
	--enable-libfreetype \
	--enable-libmp3lame \
	--enable-libvorbis \
	--enable-gnutls \
	--enable-libpulse \
	--enable-sdl2 \
	--enable-opengl \
	--enable-opencl \
	--enable-openal \
	--enable-omx \
	--enable-lv2 \
	--enable-libzvbi \
	--enable-libzimg \
	--enable-libxvid \
	--enable-libxml2 \
	--enable-libwebp \
	--enable-libvidstab \
	--enable-libtwolame \
	--enable-libtheora \
	--enable-libssh \
	--enable-libsrt \
	--enable-libspeex \
	--enable-libsoxr \
	--enable-libsnappy \
	--enable-libshine \
	--enable-librubberband \
	--enable-librabbitmq \
	--enable-libopenmpt \
	--enable-libmysofa \
	--enable-libjack \
	--enable-libgsm \
	--enable-libgme \
	--enable-libfribidi \
	--enable-libfontconfig \
	--enable-libcodec2 \
	--enable-libcdio \
	--enable-libcaca \
	--enable-libbs2b \
	--enable-libbluray \
	--enable-ladspa \
	--enable-libopenjpeg \
	--enable-libflite \
	--enable-libzmq \
	--extra-libs=-lpthread
